# =============================================
# ACCEZZ — Environment Variables Template
# Copy this file to .env.local and fill in REAL values.
# NEVER commit .env.local or any file with real secrets.
# =============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- App Base URL ---
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# Used to verify Paystack webhook signatures — set this in the Paystack dashboard
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# --- Email (ZeptoMail — preferred) ---
ZEPTOMAIL_USER=emailapikey
ZEPTOMAIL_PASSWORD=your-zeptomail-api-key
ZEPTOMAIL_SENDER_EMAIL=noreply@yourdomain.com
ZEPTOMAIL_SENDER_NAME=Accezz

# --- Email (Gmail — fallback) ---
GMAIL_USER=yourapp@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# --- Inngest ---
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_BASE_URL=https://yourdomain.com

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=your-google-maps-api-key

# --- IP Geolocation ---
NEXT_PUBLIC_IPGEOLOCATION_API_KEY=your-ipgeolocation-api-key

# --- Meta / WhatsApp Business ---
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=your-whatsapp-number
META_WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
META_PHONE_NUMBER_ID=your-meta-phone-number-id
META_WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token
META_GRAPH_API_VERSION=v19.0
PAYSTACK_WHATSAPP_CALLBACK_URL=https://yourdomain.com

# --- Internal API Secret (used to protect cron/internal endpoints) ---
INTERNAL_API_SECRET=a-long-random-secret-string-at-least-32-chars

# --- Chatbot Backend (optional — legacy chatbot feature) ---
NEXT_PUBLIC_CHATBOT_API_URL=https://your-chatbot-backend-url
